# lkpearnings ingestion — environment variables.
# Copy to `.env` for local runs (python-dotenv loads it). NEVER commit real values.
# In CI these are provided as GitHub Actions secrets (see .github/workflows/ingest.yml).

# --- Cloudflare D1 (required to write; absent => safe DRY-RUN) ---
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# --- Firecrawl (required to read result PDFs -> markdown) ---
FIRECRAWL_API_KEY=

# --- LLM extraction ---
# LLM_PROVIDER selects the active provider: "claude" (default) or "openai".
LLM_PROVIDER=claude

# Claude on AWS Bedrock (used when LLM_PROVIDER=claude)
CLAUDE_BEDROCK_API_KEY=
CLAUDE_BEDROCK_REGION=us-east-1
CLAUDE_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional proxy fallback for the BSE API ---
SCRAPEDO_API_KEY=

# --- Ingestion window / cost caps (all optional; defaults shown) ---
INGEST_DAYS=2
INGEST_LIMIT=15
INGEST_MAX_PAGES=60
# Explicit date overrides (YYYYMMDD or YYYY-MM-DD). Leave blank to use INGEST_DAYS.
INGEST_FROM_DATE=
INGEST_TO_DATE=
